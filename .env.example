# ─────────────────────────────────────────────
#  SIANO v1 — environment variables
#  On a hosting panel, add these in its "Environment / Variables" tab.
# ─────────────────────────────────────────────

# Get all three of these from your SIANO pair site after linking.
SESSION_ID=
OWNER_NUMBER=
OWNER_LID=

# Optional: pair straight from this bot's console instead of using a pair site.
# Digits only, with country code (e.g. 2348012345678). Remove it after linking.
PAIR_NUMBER=

# ── Bot identity ──
BOT_NAME=SIANO
PREFIX=.
# public = everyone can use commands, private = owner/sudo only
MODE=public
STICKER_PACK=SIANO v1
STICKER_AUTHOR=
# Optional image (direct URL) shown with the menu
MENU_IMAGE=https://i.ibb.co/kg7jbDvJ/Chat-GPT-Image-Sep-23-2026-11-07-14-AM.png

# ── Automation (can also be toggled from chat with the settings command) ──
AUTO_READ=false
AUTO_TYPING=false
AUTO_VIEW_STATUS=false
AUTO_LIKE_STATUS=false
STATUS_EMOJI=💚
ANTI_CALL=false
ANTI_DELETE=false
# Applied at startup only
ALWAYS_ONLINE=false
STARTUP_MSG=true

# ── Server ──
# Some hosts need a web port open to keep the bot alive.
PORT=3000
# silent | error | warn | info | debug  (Baileys' internal logger)
LOG_LEVEL=silent
